<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup Label="Library">
        <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    </ItemGroup>

    <ItemGroup Label="Library .NET 4.0">
        <PackageVersion Include="Microsoft.Bcl.Async" Version="1.0.168" />
        <PackageVersion Include="Microsoft.Net.Http" Version="2.2.29" />
        <PackageVersion Include="System.ValueTuple" Version="4.5.0" />
    </ItemGroup>

    <ItemGroup Label="Tests">
        <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.FileExtensions" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.2" />
        <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" />
        <PackageVersion Include="Npgsql" Version="8.0.9" />
        <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
        <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3" />
        <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.3" />
    </ItemGroup>
</Project>
