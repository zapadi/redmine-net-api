<Solution>
  <Configurations>
    <BuildType Name="Debug" />
    <BuildType Name="DebugJson" />
    <BuildType Name="Release" />
  </Configurations>
  <Folder Name="/SolutionFolder/">
    <File Path="CHANGELOG.md" />
    <File Path="CONTRIBUTING.md" />
    <File Path="ISSUE_TEMPLATE.md" />
    <File Path="LICENSE" />
    <File Path="PULL_REQUEST_TEMPLATE.md" />
    <File Path="README.md" />
  </Folder>
  <Folder Name="/SolutionFolder/Docker/">
    <File Path="docker-compose.yml" />
  </Folder>
  <Folder Name="/SolutionFolder/GitActions/">
    <File Path=".github/dependabot.yml" />
    <File Path=".github/workflows/build-and-test.yml" />
    <File Path=".github/workflows/codeql-analysis.yml" />
    <File Path=".github/workflows/publish.yml" />
    <File Path=".github/workflows/release.yml" />
    <File Path=".github/scripts/nuget-versions.sh" />
  </Folder>
  <Folder Name="/SolutionFolder/Others/">
    <File Path="global.json" />
    <File Path="release-please-config.json" />
    <File Path=".release-please-manifest.json" />
    <File Path="logo.png" />
    <File Path="redmine-net-api.snk" />
  </Folder>
  <Folder Name="/SolutionFolder/Props/">
    <File Path="Directory.Build.props" />
    <File Path="Directory.Build.targets" />
    <File Path="Directory.Packages.props" />
    <File Path="src/Directory.Build.props" />
  </Folder>
  <Folder Name="/src/">
    <Project Path="src/redmine-net-api/redmine-net-api.csproj" />
    <Project Path="src/redmine-net-api.Http/redmine-net-api.Http.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/redmine-net-api.Integration.Tests/redmine-net-api.Integration.Tests.csproj">
      <BuildType Solution="DebugJson|*" Project="Debug" />
    </Project>
    <Project Path="tests/redmine-net-api.Tests/redmine-net-api.Tests.csproj">
      <Build Solution="Release|*" Project="false" />
    </Project>
  </Folder>
</Solution>
