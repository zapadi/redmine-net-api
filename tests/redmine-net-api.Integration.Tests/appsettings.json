{
  "TestContainer": {
    "Mode": "CreateNewWithRandomPorts",
    "Redmine":{
      "Url": "$Url",
      "Port": 4000,
      "Image": "redmine:6.1.0-alpine3.22",
      "SqlFilePath": "TestData/init-redmine.sql",
      "AuthenticationMode": "ApiKey",
      "Authentication": {
        "Basic":{
          "Username": "$Username",
          "Password": "$Password"
        },
        "ApiKey": "$ApiKey"
      }
    },
    "Postgres": {
      "Port": 5432,
      "Image": "postgres:18.0-alpine",
      "Database": "postgres",
      "User": "postgres",
      "Password": "postgres"
    }
  }
}
